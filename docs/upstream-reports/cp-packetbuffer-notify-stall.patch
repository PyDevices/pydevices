+// Runs on the VM task, from background callbacks.
+static void _retry_pending(void *self_in) {
+    bleio_packet_buffer_obj_t *self = (bleio_packet_buffer_obj_t *)self_in;
+    if (common_hal_bleio_packet_buffer_deinited(self) ||
+        self->conn_handle == BLEIO_HANDLE_INVALID ||
+        self->packet_queued) {
+        return;
+    }
+    queue_next_write(self);
+}
+
+// NimBLE couldn't take the pending packet. It reports buffers freeing up with no event, so
+// try again from the next background pass, and every pass after while it keeps failing.
+static void _schedule_retry(bleio_packet_buffer_obj_t *self) {
+    background_callback_add(&self->retry_callback, _retry_pending, self);
+}
