{
  "about": "BLE-MIDI 1.0 codec vectors, shared by every interpreter (tests/bledev_midi_codec.py). Hex strings, spaces ignored. Every expected value here was worked out by hand from the BLE-MIDI packet format, not captured from the codec. decode: packets in order through one Decoder -> [timestamp, message] pairs and the error count. encode: messages through one Encoder at a packet size -> the exact packets.",
  "decode": [
    {"name": "one note-on", "packets": ["80 80 90 3c 64"], "messages": [[0, "90 3c 64"]], "errors": 0},
    {"name": "timestamp high bits from the header", "packets": ["85 81 90 3c 64"], "messages": [[641, "90 3c 64"]], "errors": 0},
    {"name": "two messages, two timestamps", "packets": ["80 81 90 3c 64 82 80 3c 00"], "messages": [[1, "90 3c 64"], [2, "80 3c 00"]], "errors": 0},
    {"name": "running status with a new timestamp", "packets": ["80 81 90 3c 64 82 3e 64"], "messages": [[1, "90 3c 64"], [2, "90 3e 64"]], "errors": 0},
    {"name": "running status, same timestamp, no timestamp byte", "packets": ["80 81 90 3c 64 3e 64 40 64"], "messages": [[1, "90 3c 64"], [1, "90 3e 64"], [1, "90 40 64"]], "errors": 0},
    {"name": "one-byte running status (program change)", "packets": ["80 81 c0 05 06 82 07"], "messages": [[1, "c0 05"], [1, "c0 06"], [2, "c0 07"]], "errors": 0},
    {"name": "timestamp low rolls over: high part +1", "packets": ["85 fe 90 3c 64 81 90 3e 64"], "messages": [[766, "90 3c 64"], [769, "90 3e 64"]], "errors": 0},
    {"name": "13-bit wrap: high 63 rolls to 0", "packets": ["bf fe b0 07 40 83 b0 07 41"], "messages": [[8190, "b0 07 40"], [3, "b0 07 41"]], "errors": 0},
    {"name": "running status across packets", "packets": ["80 81 b0 07 40", "80 82 0a 20"], "messages": [[1, "b0 07 40"], [2, "b0 0a 20"]], "errors": 0},
    {"name": "pitch bend and channel pressure", "packets": ["80 81 e1 00 40 82 d1 7f"], "messages": [[1, "e1 00 40"], [2, "d1 7f"]], "errors": 0},
    {"name": "SysEx in one packet, F7 has its own timestamp", "packets": ["80 81 f0 7e 7f 06 01 82 f7"], "messages": [[2, "f0 7e 7f 06 01 f7"]], "errors": 0},
    {"name": "SysEx across three packets", "packets": ["80 81 f0 01 02 03", "80 04 05", "80 06 83 f7"], "messages": [[3, "f0 01 02 03 04 05 06 f7"]], "errors": 0},
    {"name": "clock inside a SysEx", "packets": ["80 81 f0 01 02 82 f8 03 04", "80 05 83 f7"], "messages": [[2, "f8"], [3, "f0 01 02 03 04 05 f7"]], "errors": 0},
    {"name": "clock opens a continuation packet", "packets": ["80 81 f0 01 02", "80 84 f8 03 04 85 f7"], "messages": [[4, "f8"], [5, "f0 01 02 03 04 f7"]], "errors": 0},
    {"name": "clock between a status and its data", "packets": ["80 81 90 3c 82 f8 64"], "messages": [[2, "f8"], [1, "90 3c 64"]], "errors": 0},
    {"name": "real-time keeps running status", "packets": ["80 81 90 3c 64 82 fa 83 3e 64"], "messages": [[1, "90 3c 64"], [2, "fa"], [3, "90 3e 64"]], "errors": 0},
    {"name": "system common cancels running status", "packets": ["80 81 90 3c 64 82 f1 20 83 3e 64"], "messages": [[1, "90 3c 64"], [2, "f1 20"]], "errors": 2},
    {"name": "tune request has no data", "packets": ["80 81 f6 82 f2 10 20"], "messages": [[1, "f6"], [2, "f2 10 20"]], "errors": 0},
    {"name": "a bad header drops the packet", "packets": ["00 90 3c 64", "c0 81 90 3c 64", "80 81 90 3c 64"], "messages": [[1, "90 3c 64"]], "errors": 2},
    {"name": "a header alone is not a packet", "packets": ["80"], "messages": [], "errors": 1},
    {"name": "a non-SysEx message split across packets is dropped", "packets": ["80 81 90 3c", "80 82 91 3e 64"], "messages": [[2, "91 3e 64"]], "errors": 1},
    {"name": "a status inside a SysEx ends it unfinished", "packets": ["80 81 f0 01 02 82 90 3c 64"], "messages": [[2, "90 3c 64"]], "errors": 1},
    {"name": "data with no status is an error", "packets": ["80 81 3c 64"], "messages": [], "errors": 2}
  ],
  "encode": [
    {"name": "running status inside a packet", "size": 20, "running_status": true,
     "messages": [[1, "90 3c 64"], [1, "90 3e 64"], [2, "90 40 64"]],
     "packets": ["80 81 90 3c 64 3e 64 82 40 64"]},
    {"name": "running status off", "size": 20, "running_status": false,
     "messages": [[1, "90 3c 64"], [1, "90 3e 64"], [2, "90 40 64"]],
     "packets": ["80 81 90 3c 64 81 90 3e 64 82 90 40 64"]},
    {"name": "a full packet starts a new one, with its status again", "size": 9, "running_status": true,
     "messages": [[1, "90 3c 64"], [2, "90 3e 64"], [3, "90 40 64"], [4, "90 41 64"]],
     "packets": ["80 81 90 3c 64 82 3e 64", "80 83 90 40 64 84 41 64"]},
    {"name": "timestamp high part in the header, rollover inside a packet", "size": 20, "running_status": true,
     "messages": [[766, "b0 07 40"], [769, "b0 07 41"]],
     "packets": ["85 fe b0 07 40 81 07 41"]},
    {"name": "a gap of 128 ms or more starts a new packet", "size": 20, "running_status": true,
     "messages": [[1, "90 3c 64"], [200, "90 3e 64"]],
     "packets": ["80 81 90 3c 64", "81 c8 90 3e 64"]},
    {"name": "SysEx split at the packet size", "size": 8, "running_status": true,
     "messages": [[5, "f0 01 02 03 04 05 06 07 08 09 0a f7"]],
     "packets": ["80 85 f0 01 02 03 04 05", "80 06 07 08 09 0a 85 f7"]},
    {"name": "a clock slips into a SysEx; a timestamp never runs backwards inside a packet", "size": 8, "running_status": true,
     "messages": [[5, "f0 01 02 03 04 05 06 07 08 09 0a f7"], [6, "90 3c 64"], [7, "f8"]],
     "packets": ["80 85 f0 01 02 03 04 05", "80 87 f8 06 07 08 09 0a", "80 87 f7", "80 86 90 3c 64"]},
    {"name": "system common is never run on", "size": 20, "running_status": true,
     "messages": [[1, "f2 10 20"], [1, "f2 10 21"]],
     "packets": ["80 81 f2 10 20 81 f2 10 21"]}
  ]
}
